DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://ecommerce:replace-with-a-strong-password@rabbitmq:5672/ecommerce
CELERY_RESULT_BACKEND=redis://redis:6379/1
RABBITMQ_DEFAULT_USER=ecommerce
RABBITMQ_DEFAULT_PASS=replace-with-a-strong-password
RABBITMQ_DEFAULT_VHOST=ecommerce
MINIO_ROOT_USER=ecommerce-minio
MINIO_ROOT_PASSWORD=replace-with-a-strong-password
MINIO_BUCKET_NAME=ecommerce-media
MINIO_ENDPOINT_URL=http://minio:9000
MINIO_PUBLIC_DOMAIN=example.com/media
MINIO_PUBLIC_URL_PROTOCOL=https:
FRONTEND_URL=https://example.com
SMSIR_API_KEY=replace-with-the-production-smsir-api-key
SMSIR_LINE_NUMBER=your-approved-service-line-number
SMSIR_BULK_ENDPOINT=https://api.sms.ir/v1/send/bulk
ZARINPAL_MERCHANT_ID=replace-with-your-live-zarinpal-merchant-id
ZARINPAL_SANDBOX=false
ZARINPAL_CALLBACK_URL=https://example.com/api/v1/orders/payments/zarinpal/callback/
ZARINPAL_REQUEST_TIMEOUT_SECONDS=10
